{
  "name": "l2-control",
  "private": true,
  "version": "0.90.2",
  "description": "L2 Control — gestión integral de parque infantil y restaurante",
  "l2": {
    "etapa": "Hacia la puesta en marcha",
    "pasos": 109
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait",
    "infra:logs": "docker compose logs -f --tail=100",
    "db:migrar": "pnpm --filter @l2/database db:deploy",
    "db:semilla": "pnpm --filter @l2/web semilla",
    "equipos": "pnpm --filter @l2/web equipos",
    "credenciales": "pnpm --filter @l2/web credenciales",
    "build": "turbo run build",
    "lint": "node scripts/lint.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "turbo run test:db",
    "arch": "depcruise \"packages/*/src/**/*.{ts,tsx}\" \"packages/domain/*/src/**/*.ts\" \"packages/*/*.ts\" \"packages/database/scripts/**/*.ts\" \"apps/web/{app,src}/**/*.{ts,tsx}\" \"apps/web/*.ts\" \"apps/worker/src/**/*.ts\" \"apps/printer-agent/src/**/*.ts\" --config .dependency-cruiser.cjs",
    "arch:demo": "node scripts/arch-demo.mjs",
    "agente:empaquetar": "pnpm --filter @l2/printer-agent empaquetar",
    "verify": "pnpm typecheck && pnpm lint && pnpm lint:prueba && pnpm version:comprobar && pnpm arch && pnpm arch:demo && pnpm test",
    "verify:db": "pnpm verify && pnpm test:db",
    "lint:prueba": "node --test scripts/lint.test.mjs scripts/version.test.mjs",
    "version:comprobar": "node scripts/version.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "17.0.1",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
