{
  "name": "l2-control",
  "private": true,
  "version": "0.1.0",
  "description": "L2 Control — gestión integral de parque infantil y restaurante",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait",
    "infra:logs": "docker compose logs -f --tail=100",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "turbo run test:db",
    "arch": "depcruise \"packages/**/*.{ts,tsx}\" \"apps/**/*.{ts,tsx}\" --config .dependency-cruiser.cjs",
    "arch:demo": "node scripts/arch-demo.mjs",
    "verify": "pnpm typecheck && pnpm arch && pnpm arch:demo && pnpm test",
    "verify:db": "pnpm verify && pnpm test:db"
  },
  "devDependencies": {
    "dependency-cruiser": "17.0.1",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
