// Esquema de L2 Control — B0-2 (F1-05, ADR-002, ADR-007).
//
// Reglas que este archivo NO puede expresar y viven en las migraciones SQL:
//   · RLS forzada en toda tabla con tenant_id: `SELECT l2_aislar_por_tenant('tabla');`
//   · disparadores append-only (pagos, auditoría, movimientos de stock).
// Reglas que sí se comprueban leyendo este archivo (src/esquema.test.ts):
//   · ningún `Float`: el dinero es BigInt en unidades menores (I-01, F3-02);
//   · todo modelo de negocio lleva `tenantId`, y es la primera columna de cada índice compuesto.
//
// Nombres: modelos en inglés como el ERD del plan (§6); tablas y columnas en snake_case.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Un cliente del SaaS (DEC-3). Hoy hay uno: Abby Kingdom.
model Tenant {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  branches           Branch[]
  exchangeRates      ExchangeRate[]
  taxRates           TaxRate[]
  bankHolidays       BankHoliday[]
  paymentMethods     PaymentMethod[]
  collectionDetails  CollectionDetails[]
  products           Product[]
  productCategories  ProductCategory[]
  systemReleases     SystemRelease[]
  systemUpdates      SystemUpdate[]
  setupPostponements SetupPostponement[]
  backupCopies       BackupCopy[]
  backupReceivers    BackupReceiver[]
  guardians          Guardian[]
  discountRules      DiscountRule[]

  @@map("tenant")
}

/// Una sucursal. El permiso incluye la sucursal (F2-06): nada opera sin saber en cuál.
model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  tariffVersions  ParkTariffVersion[]
  auditEntries    AuditEntry[]
  staff           StaffUserBranch[]
  devices         Device[]
  roleAdjustments RoleAdjustment[]
  sessions        StaffSession[]

  payments          Payment[]
  cashShifts        CashShift[]
  posTerminals      PosTerminal[]
  accounts          Account[]
  sales             Sale[]
  parkSessions      ParkSession[]
  outbox            OutboxEvent[]
  settings          BranchSettingsVersion[]
  floorPlans        FloorPlanVersion[]
  kitchenOrders     KitchenOrder[]
  stockMovements    StockMovement[]
  stockEntries      StockEntry[]
  stockAdjustments  StockAdjustment[]
  printers          Printer[]
  printAgents       PrintAgent[]
  printJobs         PrintJob[]
  eventCatalogs     EventCatalogVersion[]
  eventReservations EventReservation[]
  eventDays         EventDay[]
  paperLoads        PaperLoad[]

  @@unique([tenantId, name])
  /// Destino de las FK compuestas: una fila solo puede apuntar a una sucursal de SU tenant.
  /// Las comprobaciones de FK no pasan por la RLS, así que sin esto A podría citar la sucursal de B.
  @@unique([tenantId, id])
  @@map("branch")
}

/// Una publicación del tarifario del parque (F5-04): sus paquetes y su política, juntos.
/// Solo se añaden filas: publicar es una versión nueva y el pasado no se reescribe (regla 5).
/// El vigente es la versión más alta de la sucursal.
model ParkTariffVersion {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  version     Int
  /// `TarifarioDto` de @l2/contracts. Se valida al escribir y otra vez al leer: una fila que ya
  /// no cumple el contrato se niega en vez de venderse (fail-closed).
  content     Json
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(3)
  /// Quién publicó. Nulo hasta que exista la sesión en el servidor (B1).
  publishedBy String?  @map("published_by") @db.Uuid

  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, branchId, version])
  @@map("park_tariff_version")
}

/// Los ajustes de una sucursal (B4-4): formato de hora, zona, horario, residuo, umbral del arqueo,
/// horas de una huérfana y servicio. Publicar añade una versión; nunca reescribe la anterior (regla
/// 5). La vigente es la más alta; sin ninguna, el servidor usa los valores de fábrica.
model BranchSettingsVersion {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  version         Int
  /// `AjustesSucursalDto` de @l2/contracts. Se valida al escribir y otra vez al leer: una fila que
  /// ya no cumple el contrato se niega en vez de operar con ella (fail-closed).
  content         Json
  publishedAt     DateTime @default(now()) @map("published_at") @db.Timestamptz(3)
  publishedBy     String?  @map("published_by") @db.Uuid
  /// El nombre de quien publicó, copiado: la pantalla lo enseña sin leer el personal.
  publishedByName String?  @map("published_by_name")

  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, branchId, version])
  @@map("branch_settings_version")
}

/// El plano del local publicado (B6-1, F6-01): cada publicación es una versión nueva, solo-agregar.
/// Una mesa no se borra (se retira) y la versión dice quién lo publicó.
model FloorPlanVersion {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  version         Int
  /// `PlanoLocalDto` de @l2/contracts. Se valida al escribir y otra vez al leer (fail-closed).
  content         Json
  publishedAt     DateTime @default(now()) @map("published_at") @db.Timestamptz(3)
  publishedBy     String?  @map("published_by") @db.Uuid
  publishedByName String?  @map("published_by_name")

  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, branchId, version])
  @@map("floor_plan_version")
}

/// El registro de auditoría (§7.4, F2-07). Solo se añaden filas: ni el dueño de la tabla puede
/// editar o borrar un asiento. Se escribe en la MISMA transacción que la operación y ANTES de
/// ella: si el asiento no entra, la operación no ocurre (fail-closed).
model AuditEntry {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  /// Nula en lo que no es de una sucursal (p. ej., un intento de acceso sin dispositivo conocido).
  branchId     String?   @map("branch_id") @db.Uuid
  occurredAt   DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Día de negocio (ADR-009). Nulo hasta que exista el turno (B2-4).
  businessDate DateTime? @map("business_date") @db.Date
  /// Quién. Nulo = el sistema, o alguien sin identificar (un PIN fallido de quien no existe).
  actorId      String?   @map("actor_id") @db.Uuid
  deviceId     String?   @map("device_id") @db.Uuid
  ip           String?   @db.Inet
  /// Qué, como `tarifario.publicar` o `sesion.pin_fallido`. Catálogo en @l2/application.
  action       String
  /// HECHO o NEGADO: los rechazos también se registran (§7.4: éxito y fallo).
  outcome      String
  entityType   String?   @map("entity_type")
  entityId     String?   @map("entity_id")
  /// Estado antes y después, ya redactados (sin PIN, contactos ni referencias de pago).
  before       Json?
  after        Json?
  reason       String?
  /// Quien autorizó un 🔐 (F2-08), si lo hubo.
  authorizedBy String?   @map("authorized_by") @db.Uuid

  branch Branch? @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, occurredAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorId, occurredAt])
  @@map("audit_log")
}

/**
 * ─────────────────────────────── identidad (Etapa 1, ADR-013 y ADR-018) ──
 */

/// Una persona del equipo (F2-10). Nada se borra: dar de baja es `active = false` más su
/// asiento en `staff_user_change`. Credenciales: solo hashes y, el TOTP, cifrado.
model StaffUser {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  fullName         String    @map("full_name")
  /// Rol de la matriz §7.3 (CHECK en la migración).
  role             String
  active           Boolean   @default(true)
  /// Argon2id del PIN (ADR-013). Nulo = aún no tiene PIN: no puede entrar.
  pinHash          String?   @map("pin_hash")
  /// Bloqueo creciente (`computeLockout` del dominio): fallos seguidos y el último.
  pinFailures      Int       @default(0) @map("pin_failures")
  pinLastFailureAt DateTime? @map("pin_last_failure_at") @db.Timestamptz(3)
  /// El PIN actual es temporal (alta o reposición): al entrar con él, la persona elige el suyo
  /// antes de tener sesión.
  pinMustChange    Boolean   @default(false) @map("pin_must_change")
  /// Administración (F2-04): contraseña Argon2id. El segundo factor son sus llaves de acceso
  /// (`passkey`) y sus códigos de recuperación (ADR-020).
  passwordHash     String?   @map("password_hash")
  /// Retirado con T-4 (ADR-020): ya no se lee ni se escribe. La columna se quita en una migración
  /// de contracción, cuando ninguna versión en marcha la conozca (ADR-028).
  totpSecretEnc    String?   @map("totp_secret_enc")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  branches        StaffUserBranch[]
  changes         StaffUserChange[]
  exceptions      PermissionException[]
  sessions        StaffSession[]
  passkeys        Passkey[]
  recoveryCodes   RecoveryCode[]
  enrollmentLinks EnrollmentLink[]
  trustedDevices  TrustedDevice[]
  totpCredentials TotpCredential[]

  paymentsRecorded   Payment[]   @relation("PaymentRecordedBy")
  paymentsAuthorized Payment[]   @relation("PaymentAuthorizedBy")
  shiftsOpened       CashShift[] @relation("ShiftOpenedBy")
  shiftsClosed       CashShift[] @relation("ShiftClosedBy")

  @@unique([tenantId, id])
  @@map("staff_user")
}

/// Dónde opera cada persona (F2-06). Una excepción de permiso nunca amplía esto (§9.10.6).
model StaffUserBranch {
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  user   StaffUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  branch Branch    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, userId, branchId])
  @@map("staff_user_branch")
}

/// Lo que le pasó a una persona: ALTA, BAJA, REINGRESO, ROL o PIN (`UserChangeSchema`). Solo se añade.
model StaffUserChange {
  id       String   @id @default(uuid(7)) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  kind     String
  fromRole String?  @map("from_role")
  toRole   String?  @map("to_role")
  reason   String
  byUserId String?  @map("by_user_id") @db.Uuid
  byName   String   @map("by_name")
  at       DateTime @default(now()) @db.Timestamptz(3)

  user StaffUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, userId, at])
  @@map("staff_user_change")
}

/// Una concesión o revocación sobre el rol de una persona (DEC-15, F2-11). Retirarla no la
/// borra: pone `retired_at`. Solo una vigente por persona y acción (índice parcial).
model PermissionException {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  action        String
  /// GRANT o REVOKE.
  effect        String
  /// Para GRANT: PERMITIDO o REQUIERE_AUTORIZACION.
  permission    String?
  reason        String
  grantedBy     String?   @map("granted_by") @db.Uuid
  grantedByName String    @map("granted_by_name")
  at            DateTime  @default(now()) @db.Timestamptz(3)
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz(3)

  user StaffUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, userId])
  @@map("permission_exception")
}

/// Un ajuste de la sucursal sobre un rol entero (F2-13). Retirar pone `retired_at`.
model RoleAdjustment {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  branchId   String    @map("branch_id") @db.Uuid
  role       String
  action     String
  permission String
  reason     String
  byUserId   String?   @map("by_user_id") @db.Uuid
  byName     String    @map("by_name")
  at         DateTime  @default(now()) @db.Timestamptz(3)
  retiredAt  DateTime? @map("retired_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, branchId])
  @@map("role_adjustment")
}

/// Una llave de acceso (WebAuthn) de una persona (ADR-020): el segundo factor de administración.
/// Aquí solo vive su clave PÚBLICA; la privada no sale del equipo o del teléfono que la guarda.
/// Retirarla no la borra (regla 5): pone `retired_at`.
model Passkey {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// El identificador que da el autenticador, en base64url.
  credentialId String    @unique @map("credential_id")
  /// La clave pública en COSE, tal como la entrega el autenticador.
  publicKey    Bytes     @map("public_key")
  /// El contador de firmas del autenticador: si retrocede, la llave pudo ser clonada.
  counter      BigInt    @default(0)
  transports   String[]
  /// Dónde se registró («Laptop de caja»), para reconocerla en la lista.
  label        String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  retiredAt    DateTime? @map("retired_at") @db.Timestamptz(3)

  user StaffUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, userId])
  @@map("passkey")
}

/// Un equipo de confianza de una persona de administración (ADR-029): en él, confirmar identidad pide
/// solo la contraseña. Es de ESA persona en ESE equipo y solo vale con el equipo aprobado. Retirarla
/// no la borra: pone `revoked_at`.
model TrustedDevice {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  deviceId      String    @map("device_id") @db.Uuid
  /// Cómo se marcó: «En la instalación inicial», «Al confirmar con la app de autenticación»…
  reason        String
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedByName String?   @map("revoked_by_name")

  user   StaffUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  device Device    @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, userId])
  @@index([tenantId, deviceId])
  @@map("trusted_device")
}

/// La app de autenticación de una persona (TOTP, ADR-029): su secreto, cifrado. Vale cuando se
/// confirma con el primer código; `last_step` es el último intervalo de 30 s aceptado, para que un
/// código no valga dos veces. Cambiarla o quitarla no la borra: pone `retired_at`.
model TotpCredential {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  secretEnc   String    @map("secret_enc")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  lastStep    BigInt?   @map("last_step")
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz(3)

  user StaffUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, userId])
  @@map("totp_credential")
}

/// Un código de recuperación de un solo uso (ADR-020). Se enseña una vez; aquí queda su SHA-256.
/// Usarlo o reponer el juego no lo borra: pone `used_at` o `retired_at`.
model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(3)

  user StaffUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, userId])
  @@map("recovery_code")
}

/// Un enlace de alta de un solo uso (ADR-020): ALTA da contraseña, llave y códigos (y retira lo
/// anterior); LLAVE añade otra llave a quien ya tiene contraseña. Caduca a las 24 h.
model EnrollmentLink {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// ALTA o LLAVE.
  kind          String
  secretHash    String    @unique @map("secret_hash")
  createdBy     String?   @map("created_by") @db.Uuid
  createdByName String    @map("created_by_name")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Contraseñas erradas al usarlo (solo LLAVE): con cinco, el enlace deja de valer.
  failures      Int       @default(0)

  user StaffUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, userId])
  @@map("enrollment_link")
}

/// Un desafío de WebAuthn pendiente de respuesta: de un solo uso y de pocos minutos. `payload`
/// lleva lo que la ceremonia necesita recordar entre sus dos pasos (nunca un secreto en claro).
/// Sin FK al tenant: la instalación inicial lo usa antes de que el local exista.
model AuthChallenge {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  /// INSTALACION, ALTA, LLAVE, ELEVAR o APROBAR_EQUIPO.
  purpose   String
  challenge String
  userId    String?   @map("user_id") @db.Uuid
  deviceId  String?   @map("device_id") @db.Uuid
  payload   Json?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  @@index([tenantId, expiresAt])
  @@map("auth_challenge")
}

/// La instalación inicial de un local (ADR-020, M-12): una fila por tenant. Mientras no esté
/// hecha guarda el SHA-256 del código de instalación vigente y sus intentos fallidos; hecha, dice
/// cuándo y por quién, y la pantalla de instalación no vuelve a existir. Sin FK al tenant: la fila
/// nace antes que él.
model Installation {
  tenantId        String    @id @map("tenant_id") @db.Uuid
  codeHash        String?   @map("code_hash")
  issuedAt        DateTime? @map("issued_at") @db.Timestamptz(3)
  failures        Int       @default(0)
  lastFailureAt   DateTime? @map("last_failure_at") @db.Timestamptz(3)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)
  completedByName String?   @map("completed_by_name")

  @@map("installation")
}

/// Un equipo del local (F2-02). Primer factor del acceso: su secreto vive en una cookie
/// `httpOnly` y aquí solo su SHA-256. Revocar no lo borra (regla 5): las sesiones que abrió lo nombran.
model Device {
  id                    String    @id @default(uuid(7)) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  branchId              String    @map("branch_id") @db.Uuid
  label                 String
  /// PENDIENTE, APROBADO o REVOCADO.
  status                String
  secretHash            String    @unique @map("secret_hash")
  registeredAt          DateTime  @default(now()) @map("registered_at") @db.Timestamptz(3)
  /// Cuándo pidió (o renovó) su registro. Una solicitud PENDIENTE caduca a las 24 h (M-7).
  requestedAt           DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  lastSeenAt            DateTime? @map("last_seen_at") @db.Timestamptz(3)
  /// Intentos fallidos de aprobarlo desde él mismo con credenciales de administración (M-7):
  /// bloqueo creciente del EQUIPO, porque quien teclea todavía no tiene identidad.
  approvalFailures      Int       @default(0) @map("approval_failures")
  approvalLastFailureAt DateTime? @map("approval_last_failure_at") @db.Timestamptz(3)

  branch    Branch          @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  changes   DeviceChange[]
  sessions  StaffSession[]
  trustedBy TrustedDevice[]

  payments   Payment[]
  cashShifts CashShift[]

  @@unique([tenantId, id])
  @@map("device")
}

/// Lo que le pasó a un equipo: ALTA, RENOVADO, APROBADO, REVOCADO o RENOMBRADO. Solo se añade.
model DeviceChange {
  id       String   @id @default(uuid(7)) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  deviceId String   @map("device_id") @db.Uuid
  kind     String
  label    String?
  reason   String
  byUserId String?  @map("by_user_id") @db.Uuid
  byName   String   @map("by_name")
  at       DateTime @default(now()) @db.Timestamptz(3)

  device Device @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, deviceId, at])
  @@map("device_change")
}

/// Una sesión de una persona en un equipo (F2-12). El token vive en una cookie `httpOnly`;
/// aquí, su SHA-256. Se cierra de verdad en el servidor (`closed_at`) y no se reabre.
model StaffSession {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  deviceId      String    @map("device_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  openedAt      DateTime  @default(now()) @map("opened_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Hasta cuándo vale la elevación con contraseña y TOTP (F2-04). Nulo = sin elevar.
  elevatedUntil DateTime? @map("elevated_until") @db.Timestamptz(3)
  closedAt      DateTime? @map("closed_at") @db.Timestamptz(3)
  /// SALIDA, INACTIVIDAD, DISPOSITIVO_REVOCADO, BAJA, CORTE_Z, OTRA_SESION.
  closedReason  String?   @map("closed_reason")

  user   StaffUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  device Device    @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  branch Branch    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, deviceId, closedAt])
  @@index([tenantId, userId, closedAt])
  @@map("staff_session")
}

/**
 * ──────────────────────────────────────────────── dinero (Etapa 2, §5) ──
 */

/// Una tasa de cambio capturada (§5.2, F3-03). Registro histórico: solo se añade, y corregir una
/// mal tecleada es capturar otra (regla 5). Es del tenant y no de una sucursal: el BCV publica
/// una sola para todo el país. Cada pago citará la suya por `id` (ADR-005).
model ExchangeRate {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  /// USD/VES o USDT/VES (CHECK en la migración).
  pair           String
  /// Texto decimal exacto, como en el contrato; CHECK de formato y de valor distinto de cero.
  /// Nunca Float (F3-02): el error se multiplicaría por todo lo que se cobre en bolívares.
  value          String
  /// BCV, MANUAL o COMERCIAL: sin procedencia, una tasa no es auditable.
  source         String
  /// Fecha valor: el día para el que vale (el `effectiveFrom` de §5.2).
  effectiveDate  DateTime @map("effective_date") @db.Date
  capturedAt     DateTime @default(now()) @map("captured_at") @db.Timestamptz(3)
  /// Quién la cargó. Nulo = un proceso (la sincronización del BCV, F3-04).
  capturedBy     String?  @map("captured_by") @db.Uuid
  capturedByName String   @map("captured_by_name")
  /// Lo que respondió la fuente automática (§5.2 `rawPayload`), recortado a lo que importa. Nulo
  /// en una carga manual.
  rawPayload     Json?    @map("raw_payload")
  /// Solo en una traída automáticamente que NO se aplicó sola (ADR-019): PRIMERA, SALTO o
  /// SOLO_TERCERO. Se decide al traerla y no cambia (la tabla es de solo-agregar).
  heldBack       String?  @map("held_back")

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  confirmation ExchangeRateConfirmation?

  payments Payment[]

  @@unique([tenantId, id])
  /// Dos capturas del mismo par en el mismo instante serían una reescritura disfrazada.
  @@unique([tenantId, pair, capturedAt])
  @@index([tenantId, pair, effectiveDate])
  @@map("exchange_rate")
}

/// La confirmación humana de una tasa (§5.2): sin ella no se cobra con la tasa. Es una fila
/// aparte, y no una columna de la tasa, porque la tasa no se reescribe: confirmar AÑADE un hecho.
model ExchangeRateConfirmation {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  rateId           String   @map("rate_id") @db.Uuid
  confirmedAt      DateTime @default(now()) @map("confirmed_at") @db.Timestamptz(3)
  confirmedBy      String?  @map("confirmed_by") @db.Uuid
  confirmedByName  String   @map("confirmed_by_name")
  /// Si se tecleó el valor otra vez: salto sobre el umbral, o la primera tasa del par.
  doubleChecked    Boolean  @map("double_checked")
  /// Quién autorizó el 🔐 de supervisión (§7.3, F2-08), si hizo falta.
  authorizedBy     String?  @map("authorized_by") @db.Uuid
  authorizedByName String?  @map("authorized_by_name")
  /// Aplicada sola por la sincronización del BCV (ADR-019), sin persona detrás. La bandera, y
  /// no el nombre, es lo que dice que fue automática.
  automatic        Boolean  @default(false)

  rate ExchangeRate @relation(fields: [tenantId, rateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  /// Una tasa se confirma una vez.
  @@unique([tenantId, rateId])
  @@map("exchange_rate_confirmation")
}

/// Una alícuota programada (B2-2, F3-06): «desde tal instante, tal alícuota». Solo-agregar: su
/// fin es el comienzo de la siguiente del mismo impuesto, que el dominio calcula (`taxTimeline`).
/// Lo exento no se guarda: es cero por definición. Del local entero (tenant), como la tasa.
model TaxRate {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  /// IVA o IGTF (CHECK en la migración).
  tax             String
  /// GENERAL o REDUCIDA en el IVA; nulo en el IGTF (CHECK).
  code            String?
  /// Puntos básicos: 16 % = 1600. Entero, nunca Float (F3-02).
  basisPoints     Int      @map("basis_points")
  /// Desde cuándo rige. Nunca antes de programarse (CHECK): el pasado no se reescribe.
  effectiveFrom   DateTime @map("effective_from") @db.Timestamptz(3)
  scheduledAt     DateTime @default(now()) @map("scheduled_at") @db.Timestamptz(3)
  /// Quién la programó. Nulo = un proceso (la semilla).
  scheduledBy     String?  @map("scheduled_by") @db.Uuid
  scheduledByName String   @map("scheduled_by_name")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, tax, effectiveFrom])
  @@map("tax_rate")
}

/// Un asiento del libro de pagos (B2-3, §5.5, F3-09, F3-10). Solo-agregar (I-09): un error se
/// corrige con una reversión que apunta al original, con el signo contrario. El saldo de un
/// documento es la suma de sus asientos, calculada; nunca se guarda.
model Payment {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  /// El documento (cuenta o venta) al que se aplica. Su tabla y su FK llegan con B3-3.
  documentId       String   @map("document_id") @db.Uuid
  /// El turno en el que se asentó: sin turno abierto no se cobra (F4-01, B3-1).
  shiftId          String   @map("shift_id") @db.Uuid
  /// El día de negocio del turno (ADR-009, F3-11): igual al de su turno (disparador).
  businessDate     DateTime @map("business_date") @db.Date
  /// La clave de idempotencia de la operación (un cobro, una reversión) y la línea dentro de ella.
  operationKey     String   @map("operation_key") @db.Uuid
  line             Int      @db.SmallInt
  /// COBRO, VUELTO, PROPINA o RESIDUO (§5.6).
  kind             String
  /// El código de un medio del catálogo del local (B3-2, §9.9). La FK lleva la moneda: la del
  /// asiento es la de su medio.
  method           String
  currency         String
  /// Unidades menores, con signo: negativo solo en una reversión. Nunca Float (I-01).
  amountMinor      BigInt   @map("amount_minor")
  /// IGTF de ESTE asiento, en su moneda y con el mismo signo (§5.5).
  igtfMinor        BigInt   @map("igtf_minor")
  /// La tasa congelada (ADR-005): cuál y con qué valor, copiado al asentar.
  rateId           String?  @map("rate_id") @db.Uuid
  rateValue        String?  @map("rate_value")
  reversesId       String?  @map("reverses_id") @db.Uuid
  /// Solo en una reversión: motivo de la lista cerrada (DEC-24) y su explicación.
  reason           String?
  reasonDetail     String?  @map("reason_detail")
  recordedAt       DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  recordedBy       String?  @map("recorded_by") @db.Uuid
  recordedByName   String   @map("recorded_by_name")
  deviceId         String?  @map("device_id") @db.Uuid
  authorizedBy     String?  @map("authorized_by") @db.Uuid
  authorizedByName String?  @map("authorized_by_name")
  /// Los datos del pago (F4-04: referencia, TxID, titular), cifrados con AES-256-GCM (§7.6). Solo
  /// en un cobro original, y siempre que su medio los pida (disparador).
  referenceCipher  String?  @map("reference_cipher")
  /// HMAC de lo que identifica el pago en su banco: reconoce una referencia ya cobrada sin
  /// guardarla en claro. Nulo si no hay nada que la identifique (un Zelle sin confirmación).
  referenceDigest  String?  @map("reference_digest")
  /// El terminal por el que pasó la tarjeta, de esta misma sucursal (FK compuesta).
  terminalId       String?  @map("terminal_id") @db.Uuid

  branch     Branch        @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  medio      PaymentMethod @relation(fields: [tenantId, method, currency], references: [tenantId, code, currency], onDelete: Restrict, onUpdate: Restrict)
  terminal   PosTerminal?  @relation(fields: [tenantId, branchId, terminalId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  rate       ExchangeRate? @relation(fields: [tenantId, rateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  reverses   Payment?      @relation("PaymentReversal", fields: [tenantId, reversesId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  reversedBy Payment[]     @relation("PaymentReversal")
  recorder   StaffUser?    @relation("PaymentRecordedBy", fields: [tenantId, recordedBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  authorizer StaffUser?    @relation("PaymentAuthorizedBy", fields: [tenantId, authorizedBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  device     Device?       @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  shift      CashShift     @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  /// El documento es la cuenta que se cobra (B3-3): un asiento no cita una cuenta de otro local.
  account    Account       @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  /// I-11: la misma operación no se asienta dos veces.
  @@unique([tenantId, operationKey, line])
  @@index([tenantId, documentId])
  @@index([tenantId, businessDate])
  @@index([tenantId, referenceDigest])
  @@map("payment")
}

/// Un medio de pago del catálogo del local (B3-2, F4-02, §9.9): un dato, no una constante del
/// código, y añadir uno no exige desplegar. No se borra (los asientos lo citan) y lo que lo define
/// no cambia: código, moneda, si da vuelto y qué datos pide (disparador). Se enciende y se apaga.
model PaymentMethod {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  code          String
  label         String
  /// USD, VES o USDT (CHECK).
  currency      String
  /// Efectivo de la gaveta: el único que da vuelto (§5.6).
  givesChange   Boolean  @map("gives_change")
  triggersIgtf  Boolean  @map("triggers_igtf")
  /// PAGO_MOVIL, ZELLE, USDT o PUNTO: los datos que pide para conciliar (F4-04). Nulo, ninguno.
  dataKind      String?  @map("data_kind")
  active        Boolean
  /// El orden en la caja y en la configuración.
  position      Int      @db.SmallInt
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdByName String   @map("created_by_name")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payments      Payment[]
  discountRules DiscountRule[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  /// Destino de la FK del libro: el asiento cita el medio CON su moneda.
  @@unique([tenantId, code, currency])
  @@map("payment_method")
}

/// Un terminal de punto de venta de la sucursal (B3-2, F4-02). No se borra: un pago con punto dice
/// por cuál pasó la tarjeta. Uno retirado se retira una vez, con quién y cuándo.
model PosTerminal {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  name          String
  bank          String
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String?   @map("created_by") @db.Uuid
  createdByName String    @map("created_by_name")
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz(3)
  retiredBy     String?   @map("retired_by") @db.Uuid
  retiredByName String?   @map("retired_by_name")

  branch   Branch    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  payments Payment[]

  @@unique([tenantId, id])
  /// Destino de la FK del libro: el terminal de un pago es de SU sucursal.
  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId])
  @@map("pos_terminal")
}

/// Los datos que la caja enseña al cliente para que pague (B3-2, F4-04): el Pago Móvil y el Zelle
/// del local. Solo-agregar: cambiarlos añade una fila y rige la última. Cifrados (§7.6): un Zelle
/// puede ser la cuenta personal de quien lleva el negocio.
model CollectionDetails {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  /// PAGO_MOVIL o ZELLE (CHECK).
  kind           String
  dataCipher     String   @map("data_cipher")
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  recordedBy     String?  @map("recorded_by") @db.Uuid
  recordedByName String   @map("recorded_by_name")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, kind, recordedAt])
  @@map("collection_details")
}

/// Un turno de caja (B3-1, F4-01, ADR-009, I-06): un equipo, un turno abierto. No se borra y solo
/// avanza (ABIERTO → EN_CIERRE → CERRADO_Z); lo que declara al abrir no cambia nunca (disparador).
model CashShift {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  branchId     String    @map("branch_id") @db.Uuid
  deviceId     String    @map("device_id") @db.Uuid
  /// El punto de cobro: el nombre del equipo al abrir (DEC-13).
  pointLabel   String    @map("point_label")
  /// El día de negocio que declara el turno (ADR-009): el del local al abrirlo.
  businessDate DateTime  @map("business_date") @db.Date
  /// ABIERTO, EN_CIERRE o CERRADO_Z (CHECK).
  status       String
  openedAt     DateTime  @default(now()) @map("opened_at") @db.Timestamptz(3)
  openedBy     String    @map("opened_by") @db.Uuid
  openedByName String    @map("opened_by_name")
  closedAt     DateTime? @map("closed_at") @db.Timestamptz(3)
  closedBy     String?   @map("closed_by") @db.Uuid
  closedByName String?   @map("closed_by_name")

  branch     Branch           @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  device     Device           @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  opener     StaffUser        @relation("ShiftOpenedBy", fields: [tenantId, openedBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  closer     StaffUser?       @relation("ShiftClosedBy", fields: [tenantId, closedBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  floats     CashShiftFloat[]
  payments   Payment[]
  sales      Sale[]
  counts     ShiftCount[]
  cuts       ShiftCut[]
  paperLoads PaperLoad[]

  @@unique([tenantId, id])
  @@index([tenantId, branchId, businessDate])
  @@map("cash_shift")
}

/// El fondo inicial del turno, por moneda de la gaveta (F4-01). Solo-agregar.
model CashShiftFloat {
  id          String @id @default(uuid(7)) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  shiftId     String @map("shift_id") @db.Uuid
  /// USD o VES: lo que hay en el cajón (CHECK).
  currency    String
  /// Unidades menores, cero o más. Nunca Float.
  amountMinor BigInt @map("amount_minor")

  shift CashShift @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, shiftId, currency])
  @@map("cash_shift_float")
}

/// Un feriado bancario del local (B2-4, D-FER): no es día hábil, y la tasa del día hábil anterior
/// lo cubre. No se borra: uno registrado por error se retira, una vez, con quién y cuándo.
model BankHoliday {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  day           DateTime  @db.Date
  name          String
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String?   @map("created_by") @db.Uuid
  createdByName String    @map("created_by_name")
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz(3)
  retiredBy     String?   @map("retired_by") @db.Uuid
  retiredByName String?   @map("retired_by_name")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, day])
  @@map("bank_holiday")
}

/// Un producto del catálogo del local (B9-1, F8-02): lo que se vende en el mostrador o se añade a
/// una cuenta abierta. No se borra (lo vendido lo nombra): se aparta con `active`. Se edita el
/// nombre, la categoría, el trato del IVA y si lleva stock, con asiento de auditoría; quién lo creó
/// y cuándo no cambia (disparador). El precio no vive aquí: es un calendario (`ProductPrice`).
/// Las categorías del catálogo (T-10, M-24): una lista que administra el local (crear, renombrar,
/// unir, retirar una vacía) y que nace con unas de arranque. El producto guarda el nombre de la suya
/// (`product.category`); renombrar o unir cambia ese nombre en sus productos, en la misma transacción.
model ProductCategory {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdByName String    @map("created_by_name")
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz(3)
  retiredByName String?   @map("retired_by_name")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@map("product_category")
}

model Product {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String
  category      String
  /// GENERAL, REDUCIDA o EXENTA (CHECK): el trato del IVA, la alícuota es del calendario.
  taxCode       String   @map("tax_code")
  /// Si su existencia se lleva por movimientos (B9-2).
  tracksStock   Boolean  @map("tracks_stock")
  /// El stock mínimo (B9-5): su punto de reorden. Con la existencia en él o por debajo, avisa. Nulo = sin mínimo.
  minStock      Int?     @map("min_stock")
  /// PRODUCTO (se cuenta), PREPARADO (se hace al momento) o SERVICIO (CHECK, B9-6). Solo el PRODUCTO lleva existencia.
  kind          String
  /// El código interno (B9-6): prefijo de su categoría y correlativo, «BEB-0001». Lo pone el servidor y no cambia.
  sku           String
  /// El código de barras del empaque, si lo trae (solo un PRODUCTO). Único en el local.
  barcode       String?
  /// «Lata 355 ml», «Bolsa 45 g»: distingue dos productos de nombre parecido.
  presentation  String?
  active        Boolean
  /// Si el mesero lo ofrece en las mesas (B6-1): la carta del restaurante es el catálogo con esta marca.
  onMenu        Boolean  @default(true) @map("on_menu")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String?  @map("created_by") @db.Uuid
  createdByName String   @map("created_by_name")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  prices         ProductPrice[]
  stockMovements StockMovement[]

  /// Destino de la FK compuesta de los precios: un precio es de un producto de SU tenant.
  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@map("product")
}

/// Un precio programado (B9-1, F8-02). Solo-agregar: cambiar el precio programa la fila siguiente
/// con su comienzo, y el calendario lo arma `priceTimeline` de @l2/domain-inventory. Lo vendido
/// copió su precio: nada de esto lo reescribe. En dólares y en unidades menores (nunca Float).
model ProductPrice {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  amountMinor     BigInt   @map("amount_minor")
  /// USD (CHECK): la moneda funcional (DEC-1).
  currency        String   @default("USD")
  /// Desde cuándo rige. Nunca antes de programarse (CHECK): el pasado no se reescribe.
  effectiveFrom   DateTime @map("effective_from") @db.Timestamptz(3)
  scheduledAt     DateTime @default(now()) @map("scheduled_at") @db.Timestamptz(3)
  /// Quién lo programó. Nulo = un proceso (la semilla).
  scheduledBy     String?  @map("scheduled_by") @db.Uuid
  scheduledByName String   @map("scheduled_by_name")

  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  /// Dos programaciones del mismo producto en el mismo instante no se ordenan: la segunda se rechaza.
  @@unique([tenantId, productId, scheduledAt])
  @@index([tenantId, productId, effectiveFrom])
  @@map("product_price")
}

/// Una cuenta (B3-3, DEC-21): de una familia, de una mesa o de una venta de mostrador. La fila dice
/// lo que no cambia (de quién es, su número de orden, cuándo se abrió); lo que cambia vive en sus
/// versiones. Solo-agregar las dos: nada se reescribe, cada cambio añade una versión (regla 5).
model Account {
  /// Lo genera la pantalla (UUID) para que un reintento no abra dos cuentas.
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  /// FAMILIA, MESA, MOSTRADOR o EVENTO (CHECK).
  kind         String
  /// El correlativo de la sucursal que se dice en voz alta (D13: continuo). Lo pone el servidor.
  orderNumber  Int      @map("order_number")
  openedAt     DateTime @map("opened_at") @db.Timestamptz(3)
  openedBy     String?  @map("opened_by") @db.Uuid
  openedByName String   @map("opened_by_name")
  deviceId     String?  @map("device_id") @db.Uuid

  branch            Branch             @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  versions          AccountVersion[]
  payments          Payment[]
  sales             Sale[]
  parkSessions      ParkSession[]
  kitchenOrders     KitchenOrder[]
  eventReservations EventReservation[]
  eventDays         EventDay[]
  paperItems        PaperLoadItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, branchId, orderNumber])
  @@map("account")
}

/// Una versión de una cuenta (B3-3): la cuenta entera como quedó tras un cambio, validada con el
/// contrato. La vigente es la de número más alto. `cause` dice qué la produjo: un «guardar» de una
/// pantalla, un cobro o una anulación (estos dos, con la clave de su operación en el libro).
model AccountVersion {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  version      Int
  /// ABIERTA, POR_COBRAR o COBRADA (CHECK), fuera del JSON para leer la cola sin abrirlo.
  status       String
  content      Json
  /// GUARDAR, COBRO o ANULACION (CHECK).
  cause        String
  operationKey String?  @map("operation_key") @db.Uuid
  savedAt      DateTime @map("saved_at") @db.Timestamptz(3)
  savedBy      String?  @map("saved_by") @db.Uuid
  savedByName  String   @map("saved_by_name")
  deviceId     String?  @map("device_id") @db.Uuid

  account        Account         @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  stockMovements StockMovement[]

  @@unique([tenantId, id])
  /// Dos cambios a la vez sobre la misma versión: el segundo tropieza aquí y se le dice CONFLICTO.
  @@unique([tenantId, accountId, version])
  @@map("account_version")
}

/// Una venta (B3-4, C12, DEC-24): la foto de un cobro de una cuenta, con sus datos (líneas, IVA,
/// IGTF, tasa, pagos con lo que se devolvería, lo que sobró). Nace en la transacción del cobro y no
/// se toca: sus impresiones y su anulación se añaden en tablas propias.
model Sale {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  /// La clave del cobro en el libro: una venta por cobro.
  operationKey String   @map("operation_key") @db.Uuid
  shiftId      String   @map("shift_id") @db.Uuid
  businessDate DateTime @map("business_date") @db.Date
  closedAt     DateTime @map("closed_at") @db.Timestamptz(3)
  cashierId    String?  @map("cashier_id") @db.Uuid
  cashierName  String   @map("cashier_name")
  deviceId     String?  @map("device_id") @db.Uuid
  orderNumber  Int      @map("order_number")
  totalMinor   BigInt   @map("total_minor")
  currency     String
  /// Lo cobrado, con la forma de `VentaCerradaSchema` sin impresiones ni anulación.
  content      Json

  branch  Branch      @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  account Account     @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  shift   CashShift   @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  prints  SalePrint[]
  voids   SaleVoid[]
  jobs    PrintJob[]

  @@unique([tenantId, id])
  @@unique([tenantId, operationKey])
  @@index([tenantId, shiftId, closedAt])
  @@map("sale")
}

/// Una impresión del recibo de una venta (§5.4): la primera es el original; las demás, copias.
model SalePrint {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  saleId        String   @map("sale_id") @db.Uuid
  printedAt     DateTime @map("printed_at") @db.Timestamptz(3)
  printedBy     String?  @map("printed_by") @db.Uuid
  printedByName String   @map("printed_by_name")
  deviceId      String?  @map("device_id") @db.Uuid
  copy          Boolean

  sale Sale @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, saleId, printedAt])
  @@map("sale_print")
}

/// La anulación de una venta (DEC-24): una por venta, con quién la pidió y autorizó, el motivo y
/// cómo volvió el dinero de cada pago (las referencias de devolución, cifradas).
model SaleVoid {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  saleId           String   @map("sale_id") @db.Uuid
  /// La clave de la anulación en el libro (sus reversiones).
  operationKey     String   @map("operation_key") @db.Uuid
  voidedAt         DateTime @map("voided_at") @db.Timestamptz(3)
  requestedBy      String?  @map("requested_by") @db.Uuid
  requestedByName  String   @map("requested_by_name")
  authorizedBy     String   @map("authorized_by") @db.Uuid
  authorizedByName String   @map("authorized_by_name")
  authorizedByRole String   @map("authorized_by_role")
  reason           String
  note             String?
  /// [{ paymentIndex, via, amountMinor, currency, referenceCipher }]
  refunds          Json

  sale Sale @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, saleId])
  @@unique([tenantId, operationKey])
  @@map("sale_void")
}

/// Un conteo de la gaveta de un turno (F4-07, B3-5): billetes por denominación, lo que decía el libro
/// en ese momento y la diferencia. A ciegas: la cajera ve lo esperado después de registrarlo.
model ShiftCount {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  shiftId            String   @map("shift_id") @db.Uuid
  countedAt          DateTime @map("counted_at") @db.Timestamptz(3)
  countedBy          String?  @map("counted_by") @db.Uuid
  countedByName      String   @map("counted_by_name")
  deviceId           String?  @map("device_id") @db.Uuid
  /// [{ currency, billetes: [{ denominacion, cantidad }] }]
  counts             Json
  /// [{ minor, currency }] por moneda: lo contado, lo esperado y la diferencia.
  counted            Json
  expected           Json
  differences        Json
  /// La diferencia en dólares con la tasa del turno; NULL si no hubo tasa para medirla.
  differenceUsdMinor BigInt?  @map("difference_usd_minor")
  rateId             String?  @map("rate_id") @db.Uuid
  rateValue          String?  @map("rate_value")
  /// CAJERA o SUPERVISION (CHECK).
  signer             String
  /// El umbral del arqueo con que se decidió quién firma (B4-4). NULL en los conteos anteriores a
  /// B4-4, que se decidieron con $ 1,00.
  thresholdUsdMinor  BigInt?  @map("threshold_usd_minor")

  shift CashShift  @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  cuts  ShiftCut[]

  @@unique([tenantId, id])
  @@index([tenantId, shiftId, countedAt])
  @@map("shift_count")
}

/// Un corte del turno (F4-05, F4-06): X, repetible, o Z, uno por turno y con su arqueo. El contenido
/// es la foto del turno en ese instante (`CorteSchema`).
model ShiftCut {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  shiftId          String   @map("shift_id") @db.Uuid
  /// X o Z (CHECK).
  kind             String
  madeAt           DateTime @map("made_at") @db.Timestamptz(3)
  madeBy           String?  @map("made_by") @db.Uuid
  madeByName       String   @map("made_by_name")
  deviceId         String?  @map("device_id") @db.Uuid
  content          Json
  /// Solo en el Z: su arqueo, qué cierre fue, quién firmó y con qué.
  countId          String?  @map("count_id") @db.Uuid
  closing          String?
  signer           String?
  authorizedBy     String?  @map("authorized_by") @db.Uuid
  authorizedByName String?  @map("authorized_by_name")
  justification    String?
  operationKey     String?  @map("operation_key") @db.Uuid

  shift CashShift   @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  count ShiftCount? @relation(fields: [tenantId, countId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  jobs  PrintJob[]

  @@unique([tenantId, id])
  @@index([tenantId, shiftId, madeAt])
  @@map("shift_cut")
}

/// Un representante del directorio (B4-1, F5-01, DEC-9): a quién se entrega el niño y a quién se
/// llama si pasa algo. Solo nombre y contacto, por decisión (sin documento, dirección ni foto).
/// `contactKey` es el contacto en dígitos normalizados: la llave con la que la entrada reconoce a la
/// familia, única en el local. Se corrige con auditoría; no se borra (sus estancias lo nombran).
model Guardian {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  fullName         String   @map("full_name")
  contactReference String   @map("contact_reference")
  contactKey       String   @map("contact_key")
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)
  createdBy        String?  @map("created_by") @db.Uuid

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kids              Kid[]
  sessions          ParkSession[]
  vipMarks          GuardianVip[]
  eventReservations EventReservation[]

  @@unique([tenantId, id])
  @@unique([tenantId, contactKey])
  @@map("guardian")
}

/// Un niño de una familia, con nombre (DEC-28: en la puerta no se pide; nace cuando alguien lo
/// nombra desde la sala o el directorio). Se corrige con auditoría; no se borra.
model Kid {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  guardianId String   @map("guardian_id") @db.Uuid
  name       String
  nickname   String?
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)

  guardian Guardian      @relation(fields: [tenantId, guardianId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sessions ParkSession[]

  @@unique([tenantId, id])
  @@index([tenantId, guardianId])
  @@map("kid")
}

/// Una estancia en el parque (B4-2, F5-02, ADR-010): una pulsera, un niño, un paquete. El reloj es
/// del servidor: `startedAt` y `endedAt` los pone él. El paquete y sus condiciones (gracia, bloque y
/// precio del excedente) se COPIAN al entrar: publicar otro tarifario no cambia lo que se cobra a
/// quien ya está dentro. Solo avanza de ACTIVA a CERRADA; una pulsera tiene una estancia activa a la
/// vez (I-04).
model ParkSession {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  branchId           String    @map("branch_id") @db.Uuid
  /// La cuenta de la familia que la paga (DEC-21).
  accountId          String    @map("account_id") @db.Uuid
  guardianId         String    @map("guardian_id") @db.Uuid
  /// Nulo hasta que alguien lo nombra (DEC-28).
  kidId              String?   @map("kid_id") @db.Uuid
  wristbandCode      String    @map("wristband_code")
  packageId          String    @map("package_id")
  packageName        String    @map("package_name")
  /// PREPAGO o POSTPAGO (CHECK).
  mode               String
  /// Nulo = tiempo abierto (ADR-011: nunca cero).
  durationMinutes    Int?      @map("duration_minutes")
  priceMinor         BigInt    @map("price_minor")
  currency           String
  /// Gracia, bloque, precio del bloque y aviso, como regían al entrar.
  terms              Json
  tariffVersion      Int       @map("tariff_version")
  startedAt          DateTime  @map("started_at") @db.Timestamptz(3)
  openedBy           String?   @map("opened_by") @db.Uuid
  openedByName       String    @map("opened_by_name")
  deviceId           String?   @map("device_id") @db.Uuid
  checkInKey         String    @map("check_in_key") @db.Uuid
  /// ACTIVA o CERRADA (CHECK).
  status             String
  endedAt            DateTime? @map("ended_at") @db.Timestamptz(3)
  closedBy           String?   @map("closed_by") @db.Uuid
  closedByName       String?   @map("closed_by_name")
  checkOutKey        String?   @map("check_out_key") @db.Uuid
  /// SALIDA (la registró la salida) o ADMINISTRATIVA (huérfana cerrada por la dirección, F5-13).
  closureKind        String?   @map("closure_kind")
  /// Por qué se cerró administrativamente.
  closureReason      String?   @map("closure_reason")
  /// D9: si lo recogió su representante (nulo en las cerradas antes de preguntarlo).
  pickedUpByGuardian Boolean?  @map("picked_up_by_guardian")
  /// D9: quién lo recogió, si no fue su representante.
  pickedUpByName     String?   @map("picked_up_by_name")
  /// El cumpleaños del que es invitado (B10-2): su estancia la paga el paquete del evento, a precio cero.
  eventReservationId String?   @map("event_reservation_id") @db.Uuid

  branch           Branch                 @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  account          Account                @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  guardian         Guardian               @relation(fields: [tenantId, guardianId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  kid              Kid?                   @relation(fields: [tenantId, kidId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  extensions       ParkSessionExtension[]
  eventReservation EventReservation?      @relation(fields: [tenantId, eventReservationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, branchId, status])
  @@index([tenantId, accountId])
  @@index([tenantId, guardianId])
  @@map("park_session")
}

/// Una recarga de tiempo (F5-11, R2): un paquete de tiempo fijo comprado para una estancia en sala.
/// Solo se añaden: la estancia conserva sus tramos y cada uno su cobro, en la cuenta de la familia.
model ParkSessionExtension {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  minutes       Int
  packageId     String   @map("package_id")
  packageName   String   @map("package_name")
  priceMinor    BigInt   @map("price_minor")
  currency      String
  operationKey  String   @map("operation_key") @db.Uuid
  createdAt     DateTime @map("created_at") @db.Timestamptz(3)
  createdBy     String?  @map("created_by") @db.Uuid
  createdByName String   @map("created_by_name")

  session ParkSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, operationKey])
  @@index([tenantId, sessionId])
  @@map("park_session_extension")
}

/**
 * ──────────────────────────────────────────────── tiempo real (Etapa 5) ──
 */

/// Lo que el worker tiene que contar en vivo (B5-1, ADR-025). No lo escribe nadie a mano: un
/// disparador de `audit_log` añade una fila por cada asiento HECHO, en la MISMA transacción que la
/// operación. Así no se pierde ningún evento ni sale uno de una operación que no ocurrió. El worker
/// la publica y la marca (`publishedAt`, una sola vez); no lleva datos, solo qué cambió.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  tenantId    String    @map("tenant_id") @db.Uuid
  /// Nula en lo que no es de una sucursal (p. ej., un equipo que pide su registro sin sesión).
  branchId    String?   @map("branch_id") @db.Uuid
  /// El asiento que lo produjo.
  auditId     String    @map("audit_id") @db.Uuid
  /// La acción del asiento (`cuenta.cobrar`): de ella salen los temas que se invalidan.
  action      String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  branch Branch? @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, publishedAt, id])
  @@map("outbox_event")
}

/// Un movimiento de existencia (B9-2, F8-05, I-10, ADR-023). La existencia de un producto en una
/// sucursal es la SUMA de sus movimientos: no hay un campo «stock» que alguien edite. Solo-agregar:
/// un error se corrige con otro movimiento. En unidades de venta (enteras).
///
/// Una VENTA sale cuando la línea entra en una cuenta y una DEVOLUCION cuando se quita sin pagar: las
/// dos las escribe la versión de la cuenta que las causa, y llevan su clave (cuenta, versión,
/// producto), así que un reintento no descuenta dos veces.
model StockMovement {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  /// Positivo entra, negativo sale. Nunca cero (CHECK).
  quantity       Int
  /// VENTA, DEVOLUCION, ENTRADA, SALIDA o AJUSTE (CHECK).
  kind           String
  /// Lo que vale el movimiento al costo, en centavos de dólar (B9-3): una ENTRADA, lo que costó; una
  /// VENTA, lo que sale al costo promedio (negativo); una DEVOLUCION, lo que la cuenta había sacado.
  /// La suma es el valor del inventario, y valor entre unidades, el costo promedio ponderado.
  valueMinor     BigInt   @map("value_minor")
  /// La cuenta y la versión que lo causaron (VENTA y DEVOLUCION).
  accountId      String?  @map("account_id") @db.Uuid
  accountVersion Int?     @map("account_version")
  /// La entrada de mercancía (ENTRADA), con cómo se compró: tantos bultos de tantas unidades.
  entryId        String?  @map("entry_id") @db.Uuid
  packs          Int?
  packSize       Int?     @map("pack_size")
  /// La salida o el conteo que lo causó (SALIDA y AJUSTE, B9-4).
  adjustmentId   String?  @map("adjustment_id") @db.Uuid
  at             DateTime @db.Timestamptz(3)
  createdBy      String?  @map("created_by") @db.Uuid
  createdByName  String   @map("created_by_name")
  deviceId       String?  @map("device_id") @db.Uuid

  branch  Branch           @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  product Product          @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  causa   AccountVersion?  @relation(fields: [tenantId, accountId, accountVersion], references: [tenantId, accountId, version], onDelete: Restrict, onUpdate: Restrict)
  entrada StockEntry?      @relation(fields: [tenantId, entryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  ajuste  StockAdjustment? @relation(fields: [tenantId, adjustmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  /// Una versión de una cuenta mueve cada producto una sola vez: un reintento tropieza aquí.
  @@unique([tenantId, accountId, accountVersion, productId])
  /// Una entrada recibe cada producto una vez.
  @@unique([tenantId, entryId, productId])
  /// Una salida o un conteo mueve cada producto una vez.
  @@unique([tenantId, adjustmentId, productId])
  @@index([tenantId, branchId, productId])
  @@map("stock_movement")
}

/// Una entrada de mercancía (B9-3, F8-06): lo que llegó de una vez, con proveedor y factura si los
/// hay. Sus líneas son movimientos ENTRADA. Solo-agregar: un error se corrige con otro movimiento.
model StockEntry {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  /// COMPRA o REPOSICION (CHECK).
  kind          String
  supplier      String?
  invoice       String?
  /// La clave del navegador: un doble clic no carga dos veces la misma entrada.
  operationKey  String   @map("operation_key") @db.Uuid
  receivedAt    DateTime @map("received_at") @db.Timestamptz(3)
  createdBy     String?  @map("created_by") @db.Uuid
  createdByName String   @map("created_by_name")
  deviceId      String?  @map("device_id") @db.Uuid

  branch    Branch          @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  movements StockMovement[]

  @@unique([tenantId, id])
  @@unique([tenantId, operationKey])
  @@index([tenantId, branchId, receivedAt])
  @@map("stock_entry")
}

/// Una salida o un conteo físico (B9-4, F8-07). La SALIDA saca con un motivo de lista cerrada (merma,
/// consumo interno, regalo o devolución al proveedor); el CONTEO deja la existencia igual a lo contado.
/// Los dos con la 🔐 de quien autoriza, registrada antes de mover nada (§7.3). Sus líneas son
/// movimientos SALIDA o AJUSTE; `content` guarda lo que se declaró (en el conteo, lo que el sistema
/// esperaba y lo que se contó, aunque cuadre). Solo-agregar.
model StockAdjustment {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  /// SALIDA o CONTEO (CHECK).
  kind             String
  /// El motivo de una SALIDA (CHECK): MERMA, CONSUMO_INTERNO, REGALO o DEVOLUCION_PROVEEDOR. Nulo en un CONTEO.
  reason           String?
  note             String?
  content          Json
  operationKey     String   @map("operation_key") @db.Uuid
  at               DateTime @db.Timestamptz(3)
  createdBy        String?  @map("created_by") @db.Uuid
  createdByName    String   @map("created_by_name")
  deviceId         String?  @map("device_id") @db.Uuid
  authorizedBy     String   @map("authorized_by") @db.Uuid
  authorizedByName String   @map("authorized_by_name")

  branch    Branch          @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  movements StockMovement[]

  @@unique([tenantId, id])
  @@unique([tenantId, operationKey])
  @@index([tenantId, branchId, at])
  @@map("stock_adjustment")
}

/// Una regla de descuento (B3-6, V-9): por medio de pago, VIP o manual; un porcentaje o un monto;
/// sobre la cuenta, el parque, el restaurante o unas categorías; con su vigencia en días del local.
/// No se borra ni se reescribe (lo cobrado con ella la cita): se retira una vez, con quién y cuándo.
model DiscountRule {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  /// MEDIO, VIP o MANUAL (CHECK).
  kind          String
  /// PORCENTAJE (con `basis_points`) o MONTO (con `amount_minor` en dólares) (CHECK).
  valueKind     String    @map("value_kind")
  basisPoints   Int?      @map("basis_points")
  amountMinor   BigInt?   @map("amount_minor")
  currency      String?
  /// CUENTA, PARQUE, RESTAURANTE o CATEGORIAS (con sus `categories`) (CHECK).
  scopeKind     String    @map("scope_kind")
  categories    String[]
  /// El medio de un descuento por medio de pago; nulo en los demás (CHECK).
  methodCode    String?   @map("method_code")
  validFrom     DateTime  @map("valid_from") @db.Date
  validTo       DateTime? @map("valid_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String?   @map("created_by") @db.Uuid
  createdByName String    @map("created_by_name")
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz(3)
  retiredBy     String?   @map("retired_by") @db.Uuid
  retiredByName String?   @map("retired_by_name")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  method   PaymentMethod? @relation(fields: [tenantId, methodCode], references: [tenantId, code], onDelete: Restrict, onUpdate: Restrict)
  vipMarks GuardianVip[]

  @@unique([tenantId, id])
  @@index([tenantId, kind])
  @@map("discount_rule")
}

/// Marcar o desmarcar a una familia VIP (B3-6): solo se añaden filas, y rige la última de cada
/// familia. `discount_rule_id` nulo = se le quitó la marca.
model GuardianVip {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  guardianId     String   @map("guardian_id") @db.Uuid
  discountRuleId String?  @map("discount_rule_id") @db.Uuid
  markedAt       DateTime @map("marked_at") @db.Timestamptz(3)
  markedBy       String?  @map("marked_by") @db.Uuid
  markedByName   String   @map("marked_by_name")

  guardian Guardian      @relation(fields: [tenantId, guardianId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  rule     DiscountRule? @relation(fields: [tenantId, discountRuleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, guardianId, markedAt])
  @@map("guardian_vip")
}

/// Una impresora térmica de la sucursal (B5-2, ADR-015, ADR-026): IP privada, puerto, ancho y para qué
/// sirve (recibos y cortes, comandas). Es configuración: se edita con su auditoría, pero no se borra (los
/// trabajos la citan); se retira una vez.
model Printer {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  name          String
  ip            String
  port          Int
  /// 58 u 80 mm (CHECK).
  width         Int       @db.SmallInt
  forReceipts   Boolean   @map("for_receipts")
  forOrders     Boolean   @map("for_orders")
  inHardwareLan Boolean   @map("in_hardware_lan")
  fixedIp       Boolean   @map("fixed_ip")
  active        Boolean
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdByName String    @map("created_by_name")
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz(3)
  retiredByName String?   @map("retired_by_name")

  branch Branch     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  jobs   PrintJob[]

  @@unique([tenantId, id])
  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId])
  @@map("printer")
}

/// El agente de impresión de un equipo del local (ADR-026). Nace con un código de un solo uso (solo su
/// huella y su plazo) y, al vincularse, guarda la huella de su credencial. Se retira una vez.
model PrintAgent {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  name          String
  codeHash      String?   @map("code_hash")
  codeExpiresAt DateTime? @map("code_expires_at") @db.Timestamptz(3)
  tokenHash     String?   @map("token_hash")
  pairedAt      DateTime? @map("paired_at") @db.Timestamptz(3)
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdByName String    @map("created_by_name")
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz(3)
  retiredByName String?   @map("retired_by_name")

  branch Branch     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  jobs   PrintJob[]

  @@unique([tenantId, id])
  @@index([tenantId, branchId])
  @@map("print_agent")
}

/// Un trabajo de la cola de impresión (ADR-015): PENDIENTE → ENVIADO → CONFIRMADO | FALLIDO, y lo que falló
/// o espera puede quedar DESCARTADO por una persona. Lo que se imprime (el documento y sus bytes) no
/// cambia; solo avanza su estado, como dice el disparador.
model PrintJob {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  printerId       String    @map("printer_id") @db.Uuid
  /// RECIBO, CORTE, COMANDA o PRUEBA (CHECK).
  kind            String
  title           String
  copy            Boolean
  saleId          String?   @map("sale_id") @db.Uuid
  cutId           String?   @map("cut_id") @db.Uuid
  /// El documento (renglones de `@l2/domain-printing`): la vista previa y la constancia de qué salió.
  content         Json
  /// El ESC/POS compuesto al ancho de su impresora.
  payload         Bytes
  status          String
  attempts        Int
  nextAttemptAt   DateTime  @map("next_attempt_at") @db.Timestamptz(3)
  sentAt          DateTime? @map("sent_at") @db.Timestamptz(3)
  agentId         String?   @map("agent_id") @db.Uuid
  lastError       String?   @map("last_error")
  createdAt       DateTime  @map("created_at") @db.Timestamptz(3)
  createdBy       String?   @map("created_by") @db.Uuid
  createdByName   String    @map("created_by_name")
  deviceId        String?   @map("device_id") @db.Uuid
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(3)
  /// Quién lo descartó (solo en DESCARTADO).
  discardedBy     String?   @map("discarded_by") @db.Uuid
  discardedByName String?   @map("discarded_by_name")
  /// El pedido del mesero que imprime una COMANDA (B6-2): toda comanda lleva el suyo (CHECK).
  orderId         String?   @map("order_id") @db.Uuid

  branch  Branch        @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  printer Printer       @relation(fields: [tenantId, branchId, printerId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  sale    Sale?         @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  cut     ShiftCut?     @relation(fields: [tenantId, cutId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  agent   PrintAgent?   @relation(fields: [tenantId, agentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  order   KitchenOrder? @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, orderId])
  @@index([tenantId, branchId, status, nextAttemptAt])
  @@index([tenantId, branchId, createdAt])
  @@map("print_job")
}

/// Un pedido del mesero (B6-2, ADR-022): lo que se pidió de una vez en una mesa. Entra en la cuenta de
/// la mesa y sale en papel como comanda, en la misma transacción. Solo-agregar: anularlo es de B6-3.
model KitchenOrder {
  /// Lo genera la tablet: el reintento de un envío no pide dos veces.
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  /// El correlativo de la comanda en la sucursal, el que se canta en la cocina.
  number        Int
  /// La mesa del pedido; nula en uno de una cuenta de pie (B6-7).
  tableId       String?  @map("table_id")
  /// El número de la mesa ese día, o «De pie».
  tableLabel    String   @map("table_label")
  /// El nombre propio de su cuenta (la familia en una mesa compartida, o quien pide de pie), para la comanda.
  accountLabel  String?  @map("account_label")
  /// Lo pedido: producto, nombre, cantidad y nota (`PedidoDto.lineas`).
  items         Json
  createdAt     DateTime @map("created_at") @db.Timestamptz(3)
  createdBy     String?  @map("created_by") @db.Uuid
  createdByName String   @map("created_by_name")
  deviceId      String?  @map("device_id") @db.Uuid

  branch    Branch     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  account   Account    @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  printJobs PrintJob[]

  @@unique([tenantId, id])
  @@unique([tenantId, branchId, number])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, accountId])
  @@map("kitchen_order")
}

/// Los paquetes de cumpleaños y el anticipo publicados (B10-1, D-EVT): cada publicación es una versión
/// nueva, solo-agregar. La vigente es la más alta; sin ninguna, el local no tiene paquetes y no reserva.
model EventCatalogVersion {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  version         Int
  /// `CatalogoEventosDto` de @l2/contracts. Se valida al escribir y otra vez al leer (fail-closed).
  content         Json
  publishedAt     DateTime @default(now()) @map("published_at") @db.Timestamptz(3)
  publishedBy     String?  @map("published_by") @db.Uuid
  publishedByName String?  @map("published_by_name")

  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, branchId, version])
  @@map("event_catalog_version")
}

/// Un cumpleaños reservado (B10-1, V-10): el día, el horario en minutos desde la medianoche del local,
/// la familia, el cumpleañero, los invitados y el paquete COPIADO con su anticipo y su saldo. Nace con
/// la cuenta del anticipo y no se toca (solo-agregar): en qué va lo dice esa cuenta.
model EventReservation {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  /// La cuenta del anticipo (kind EVENTO).
  accountId      String   @map("account_id") @db.Uuid
  guardianId     String   @map("guardian_id") @db.Uuid
  eventDate      DateTime @map("event_date") @db.Date
  startsMinute   Int      @map("starts_minute")
  endsMinute     Int      @map("ends_minute")
  guests         Int
  honoree        String
  honoreeAge     Int?     @map("honoree_age")
  /// `PaqueteEventoDto` sin `active`, como regía al reservar.
  package        Json
  catalogVersion Int      @map("catalog_version")
  depositBps     Int      @map("deposit_bps")
  depositMinor   BigInt   @map("deposit_minor")
  balanceMinor   BigInt   @map("balance_minor")
  currency       String
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)
  createdBy      String?  @map("created_by") @db.Uuid
  createdByName  String   @map("created_by_name")
  deviceId       String?  @map("device_id") @db.Uuid
  /// La clave de la operación que la creó: un doble clic no reserva dos veces (I-11).
  operationKey   String   @map("operation_key") @db.Uuid

  branch   Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  account  Account  @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  guardian Guardian @relation(fields: [tenantId, guardianId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  day           EventDay?
  guestSessions ParkSession[]

  @@unique([tenantId, id])
  @@unique([tenantId, operationKey])
  @@unique([tenantId, accountId])
  @@index([tenantId, branchId, eventDate])
  @@map("event_reservation")
}

/// El día de un cumpleaños, empezado (B10-2): la cuenta del día con el saldo y lo que incluye el paquete, que
/// nace una vez por reserva. Solo-agregar: en qué va lo dicen la cuenta y las estancias de los invitados.
model EventDay {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  reservationId String   @map("reservation_id") @db.Uuid
  /// La cuenta del día (kind EVENTO con eventDay).
  accountId     String   @map("account_id") @db.Uuid
  startedAt     DateTime @map("started_at") @db.Timestamptz(3)
  startedBy     String?  @map("started_by") @db.Uuid
  startedByName String   @map("started_by_name")
  deviceId      String?  @map("device_id") @db.Uuid
  operationKey  String   @map("operation_key") @db.Uuid

  branch      Branch           @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  reservation EventReservation @relation(fields: [tenantId, reservationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  account     Account          @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, reservationId])
  @@unique([tenantId, accountId])
  @@unique([tenantId, operationKey])
  @@map("event_day")
}

/// Una carga desde papel (B3-7, V-12, ADR-027): lo que se anotó en formularios mientras no hubo sistema (N2,
/// ADR-021) y la cajera carga en SU turno. Declara la ventana del corte (`windowFrom`, `windowTo`); cada registro
/// que se le añade tiene su hora real dentro de ella. Avanza ABIERTA → CERRADA (la cajera terminó de cargar) →
/// REVISADA (supervisión la comparó con el papel); una sin registros se DESCARTA al terminar. No se borra, y
/// mientras esté ABIERTA o CERRADA su turno no se sella con el corte Z.
model PaperLoad {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  shiftId        String    @map("shift_id") @db.Uuid
  /// La ventana del corte, como la declaró la cajera: no cambia nunca (disparador).
  windowFrom     DateTime  @map("window_from") @db.Timestamptz(3)
  windowTo       DateTime  @map("window_to") @db.Timestamptz(3)
  note           String?
  /// ABIERTA, CERRADA, REVISADA o DESCARTADA (CHECK). Solo avanza (disparador).
  status         String
  /// La clave de la operación que la abrió: un doble clic no abre dos (I-11).
  operationKey   String    @map("operation_key") @db.Uuid
  /// Cuándo se abrió, con el reloj del servidor.
  openedAt       DateTime  @map("opened_at") @db.Timestamptz(3)
  openedBy       String    @map("opened_by") @db.Uuid
  openedByName   String    @map("opened_by_name")
  deviceId       String?   @map("device_id") @db.Uuid
  /// Cuando la cajera terminó de cargar (o descartó la carga vacía).
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(3)
  closedBy       String?   @map("closed_by") @db.Uuid
  closedByName   String?   @map("closed_by_name")
  /// La revisión de supervisión: quién, cuándo y qué anotó.
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  reviewedByName String?   @map("reviewed_by_name")
  reviewNote     String?   @map("review_note")

  branch Branch          @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  shift  CashShift       @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  items  PaperLoadItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, operationKey])
  @@index([tenantId, branchId, status])
  @@index([tenantId, shiftId])
  @@map("paper_load")
}

/// Un registro de una carga desde papel (B3-7): una entrada, una salida o un cobro que ya ocurrió y se anotó en
/// el formulario. `occurredAt` es la hora real que se escribió en el papel (dentro de la ventana de su carga,
/// disparador); `loadedAt`, cuándo se cargó, con el reloj del servidor. Solo-agregar. Lo que hizo la operación
/// (la cuenta, las estancias, el libro, la venta) está en sus tablas de siempre, con la hora real; esta fila dice
/// que vino del papel y deja lo que revisa supervisión.
model PaperLoadItem {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  loadId       String   @map("load_id") @db.Uuid
  /// ENTRADA, SALIDA o COBRO (CHECK).
  kind         String
  accountId    String   @map("account_id") @db.Uuid
  /// La clave de la entrada, la salida o el cobro: la misma que dejó su versión de la cuenta.
  operationKey String   @map("operation_key") @db.Uuid
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(3)
  loadedAt     DateTime @map("loaded_at") @db.Timestamptz(3)
  loadedBy     String?  @map("loaded_by") @db.Uuid
  loadedByName String   @map("loaded_by_name")
  deviceId     String?  @map("device_id") @db.Uuid
  /// Lo que se compara con el formulario (`RegistroDePapelSchema` sin lo que ya está en las columnas).
  detail       Json

  load    PaperLoad @relation(fields: [tenantId, loadId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  account Account   @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, operationKey])
  @@index([tenantId, loadId, occurredAt])
  @@index([tenantId, accountId])
  @@map("paper_load_item")
}

/// Una versión publicada que el actualizador del servidor vio, con sus imágenes ya listas (T-8b, ADR-028).
/// La escribe el actualizador del VPS; la web la lee para ofrecerla en Ajustes → Sistema.
model SystemRelease {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  version     String
  publishedAt DateTime @map("published_at") @db.Timestamptz(3)
  notes       String
  urgent      Boolean  @default(false)
  seenAt      DateTime @default(now()) @map("seen_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, version])
  @@map("system_release")
}

/// Una actualización pedida (por administración o, en staging, sola) y lo que pasó con ella (T-8b). La web
/// la pide; el actualizador del VPS la pone cuando toca y escribe cómo terminó.
model SystemUpdate {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  version         String
  fromVersion     String?   @map("from_version")
  mode            String
  state           String
  requestedAt     DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  requestedBy     String?   @map("requested_by") @db.Uuid
  requestedByName String?   @map("requested_by_name")
  startedAt       DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(3)
  detail          String?
  cancelledByName String?   @map("cancelled_by_name")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, requestedAt])
  @@map("system_update")
}

/// Un punto recomendable de la Puesta a punto que administración dejó para después (T-8b, a pedido del
/// usuario). Lo que bloquea un puesto no se pospone. Se retoma poniendo `resumedAt`; nada se borra.
model SetupPostponement {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  item            String
  postponedAt     DateTime  @default(now()) @map("postponed_at") @db.Timestamptz(3)
  postponedByName String    @map("postponed_by_name")
  resumedAt       DateTime? @map("resumed_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@map("setup_postponement")
}

/// Cada respaldo de la noche (B7-4, M-26): el volcado cifrado que el servidor deja para que lo baje la PC
/// del local, o el intento que falló con su motivo. Lo escribe `infra/produccion/respaldar.sh`; la
/// aplicación solo anota la bajada que la PC confirma con su huella. Nada se borra: la retención del
/// servidor pone `removedAt`.
model BackupCopy {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  madeAt         DateTime  @default(now()) @map("made_at") @db.Timestamptz(3)
  /// HECHO o FALLIDO.
  state          String
  /// `l2control-20261007T071500Z.l2r`: el volcado y su huella, cifrados para la clave del local.
  file           String?
  bytes          BigInt?
  sha256         String?
  /// La versión del sistema que estaba en marcha.
  version        String?
  /// Por qué falló.
  detail         String?
  downloadedAt   DateTime? @map("downloaded_at") @db.Timestamptz(3)
  downloadedFrom String?   @map("downloaded_from")
  /// La PC que lo bajó.
  downloadedBy   String?   @map("downloaded_by") @db.Uuid
  removedAt      DateTime? @map("removed_at") @db.Timestamptz(3)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pc     BackupReceiver? @relation(fields: [tenantId, downloadedBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, file])
  @@index([tenantId, madeAt])
  @@map("backup_copy")
}

/// La PC del local que baja los respaldos (B7-4, M-26), preparada desde Ajustes → Respaldos. De su
/// credencial solo se guarda la huella: la credencial se enseña una vez y la escribe quien la prepara en
/// esa PC. Una en uso a la vez; preparar otra retira la anterior. Nada se borra.
model BackupReceiver {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  secretSha256  String    @map("secret_sha256")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdByName String    @map("created_by_name")
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedByName String?   @map("revoked_by_name")
  /// La última vez que preguntó qué había, y desde dónde.
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(3)
  lastSeenFrom  String?   @map("last_seen_from")

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bajados BackupCopy[]

  @@unique([tenantId, id])
  @@unique([tenantId, secretSha256])
  @@map("backup_receiver")
}
