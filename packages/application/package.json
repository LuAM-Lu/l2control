{
  "name": "@l2/application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Casos de uso (§9.2 ❹): orquestan contrato, dominio y persistencia dentro de la transacción del tenant.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:db": "node --env-file-if-exists=../../.env --test --test-concurrency=1 --experimental-strip-types \"src/**/*.test-db.ts\"",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\""
  },
  "comment": "Es la única puerta de las apps al servidor: apps → application → database (§9.2 regla 2).",
  "dependencies": {
    "@l2/contracts": "workspace:*",
    "@l2/database": "workspace:*",
    "@l2/domain-cash": "workspace:*",
    "@l2/domain-identity": "workspace:*",
    "@l2/domain-money": "workspace:*",
    "@l2/domain-rates": "workspace:*",
    "@l2/domain-tax": "workspace:*",
    "@l2/observability": "workspace:*",
    "@node-rs/argon2": "2.2.1",
    "otpauth": "9.5.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@l2/config": "workspace:*",
    "@types/node": "24.10.1",
    "typescript": "7.0.2"
  }
}
