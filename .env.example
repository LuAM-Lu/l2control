# Variables del entorno LOCAL de desarrollo. Copia este archivo a `.env` (que git ignora).
# Son contraseñas de juguete para tu máquina: en staging y producción se generan otras y
# nunca se escriben en el repositorio.

# ── Contenedores (docker compose) ─────────────────────────────────────────────
POSTGRES_PASSWORD=l2-dev-superusuario
L2_MIGRATOR_PASSWORD=l2-dev-migrador
L2_APP_PASSWORD=l2-dev-aplicacion
VALKEY_PASSWORD=l2-dev-valkey

# Puertos en tu máquina. 5433 y no 5432, para no chocar con un PostgreSQL instalado.
L2_PG_PORT=5433
L2_VALKEY_PORT=6379

# ── Aplicación y migraciones ──────────────────────────────────────────────────
# La aplicación entra como l2_app (no crea tablas, no se salta la RLS); las migraciones,
# como l2_migrator. Las de _TEST apuntan a la base de pruebas de integración.
L2_DB_APP_URL=postgresql://l2_app:l2-dev-aplicacion@127.0.0.1:5433/l2control
L2_DB_MIGRATOR_URL=postgresql://l2_migrator:l2-dev-migrador@127.0.0.1:5433/l2control
L2_DB_TEST_APP_URL=postgresql://l2_app:l2-dev-aplicacion@127.0.0.1:5433/l2control_test
L2_DB_TEST_MIGRATOR_URL=postgresql://l2_migrator:l2-dev-migrador@127.0.0.1:5433/l2control_test

# ── Servidor web (apps/web) ───────────────────────────────────────────────────
# desarrollo | staging | produccion. Hasta que exista la sesión en el servidor (B1), las
# acciones que escriben solo corren en desarrollo.
L2_ENTORNO=desarrollo
L2_LOG_LEVEL=info
# El local de desarrollo (lo crea `pnpm db:semilla`). Con la sesión (B1) saldrán del dispositivo.
L2_TENANT_ID=0199a0c0-0000-7000-8000-00000000a001
L2_BRANCH_ID=0199a0c0-0000-7000-8000-00000000b001
# AES-256 (32 bytes en base64) para lo que se guarda cifrado: el secreto TOTP de administración
# y, más adelante, las referencias de pago. Esta es de JUGUETE; la de producción se genera con
# `openssl rand -base64 32`, se guarda fuera del repositorio y, si se pierde, lo cifrado se pierde.
L2_CLAVE_CIFRADO=ZfPWqgTcG40rr2FclpnqFn7cPpVXe8CRZuuZc1CyL/U=

# ── Canal en vivo (apps/worker, B5-1) ─────────────────────────────────────────
# El worker usa también L2_DB_APP_URL, L2_TENANT_ID, L2_BRANCH_ID y L2_CLAVE_CIFRADO (de ella
# deriva la firma de los tickets del canal, así que tiene que ser la MISMA que la de la web).
L2_VALKEY_URL=redis://:l2-dev-valkey@127.0.0.1:6379
L2_TIEMPO_REAL_PUERTO=3001
# A dónde se conectan los navegadores. Vacío = la misma máquina que sirve la página, en el
# puerto de arriba (así entra también un teléfono por la IP del local). En producción, detrás del
# proxy, la misma dirección que la web: https://l2.ejemplo.com
L2_TIEMPO_REAL_URL=
# Traer sola la tasa del BCV cada 15 minutos (la hace el worker). «no» sin internet.
L2_SINCRONIZAR_TASA=si
